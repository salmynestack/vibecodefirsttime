    style feature_get_user fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style fix_bug_name_length fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style plan_unit_tests fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px

