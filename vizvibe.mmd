flowchart TD
    %% === PROJECT GOALS ===
    %% Ultimate Goal: Membangun backend API autentikasi dan manajemen user berbasis Bun, ElysiaJS, dan Drizzle ORM
    %% Current Goal: Perencanaan dan implementasi unit test komprehensif menggunakan Bun test

    %% === START ===
    %% @project_start [start, closed, 2026-09-30, salmin]
    project_start("Inisialisasi Proyek<br/><sub>Inisialisasi repositori awal<br/>menggunakan runtime Bun dengan<br/>struktur dasar proyek backend</sub>")

    %% @setup_stack [ai-task, closed, 2026-09-30, salmin]
    setup_stack("Setup Elysia & Drizzle<br/><sub>Konfigurasi framework ElysiaJS,<br/>Drizzle ORM, koneksi PostgreSQL,<br/>serta migrasi database awal</sub>")

    %% @feature_register [ai-task, closed, 2026-09-30, salmin]
    feature_register("API Registrasi User<br/><sub>Implementasi skema tabel users,<br/>hashing password dengan bcrypt,<br/>dan endpoint POST /api/users</sub>")

    %% @feature_login [ai-task, closed, 2026-10-01, salmin]
    feature_login("API Login & Sessions<br/><sub>Implementasi skema tabel sessions,<br/>verifikasi password via bcrypt,<br/>dan endpoint POST /api/users/login</sub>")

    %% @feature_get_user [ai-task, closed, 2026-10-01, salmin]
    feature_get_user("API Get Current User<br/><sub>Validasi Bearer token sesi ke tabel<br/>sessions dan response data user<br/>pada rute GET /api/users/me</sub>")

    %% @fix_bug_name_length [ai-task, closed, 2026-10-01, salmin]
    fix_bug_name_length("Perbaikan Bug Panjang Nama<br/><sub>Penerapan maxLength 255 di Elysia<br/>TypeBox serta migrasi tipe kolom<br/>name menjadi varchar 255 di DB</sub>")

    %% @plan_unit_tests [ai-task, closed, 2026-10-01, ai]
    plan_unit_tests("Perencanaan Unit Test<br/><sub>Penyusunan katalog skenario uji<br/>seluruh API di GitHub Issue #13<br/>dan isolasi DB via bun test</sub>")

    %% @impl_unit_tests [ai-task, closed, 2026-10-01, ai]
    impl_unit_tests("Implementasi Unit Tests<br/><sub>Penulisan berkas tes di tests/,<br/>hook pembersihan data DB, dan<br/>eksekusi validasi bun test</sub>")

    %% @ultimate_goal [end, opened, 2026-10-01, user]
    ultimate_goal("Sistem Auth Selesai & Teruji<br/><sub>Sistem auth siap produksi dengan<br/>cakupan pengujian unit otomatis<br/>yang lengkap dan terverifikasi</sub>")

    %% === CONNECTIONS ===
    project_start --> setup_stack
    setup_stack --> feature_register
    feature_register --> feature_login
    feature_login --> feature_get_user
    feature_get_user --> fix_bug_name_length
    fix_bug_name_length --> plan_unit_tests
    plan_unit_tests --> impl_unit_tests
    impl_unit_tests -.-> ultimate_goal

    %% === RECENT WORK HIGHLIGHT ===
    subgraph recent [RECENT]
        impl_unit_tests
    end

