    style project_start fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style setup_stack fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style feature_register fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style feature_login fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style feature_get_user fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px
    style plan_bug_name_length fill:#1a1a2e,stroke:#a78bfa,color:#c4b5fd,stroke-width:1px

    %% Recent node (highlighted purple)
    style fix_bug_name_length fill:#2d1f4e,stroke:#c084fc,color:#e9d5ff,stroke-width:2px

