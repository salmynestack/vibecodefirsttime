flowchart TD
    %% === PROJECT GOALS ===
    %% Ultimate Goal: Membangun backend API autentikasi dan manajemen user berbasis Bun, ElysiaJS, dan Drizzle ORM
    %% Current Goal: Implementasi autentikasi login user dan pembuatan sesi token

    %% === START ===
    %% @project_start [start, closed, 2026-09-30, salmin]
    project_start("Inisialisasi Proyek<br/><sub>Inisialisasi repositori awal<br/>menggunakan runtime Bun dengan<br/>struktur dasar proyek backend</sub>")

    %% @setup_stack [ai-task, closed, 2026-09-30, salmin]
    setup_stack("Setup Elysia & Drizzle<br/><sub>Konfigurasi framework ElysiaJS,<br/>Drizzle ORM, koneksi PostgreSQL,<br/>serta migrasi database awal</sub>")

    %% @feature_register [ai-task, closed, 2026-09-30, salmin]
    feature_register("API Registrasi User<br/><sub>Implementasi skema tabel users,<br/>hashing password dengan bcrypt,<br/>dan endpoint POST /api/users</sub>")

    %% @plan_login_issue [ai-task, closed, 2026-10-01, ai]
    plan_login_issue("Perencanaan Fitur Login<br/><sub>Penyusunan dokumen issue.md dan<br/>pembuatan GitHub Issue #6 untuk<br/>panduan implementasi login</sub>")

    %% @impl_login_sessions [ai-task, closed, 2026-10-01, ai]
    impl_login_sessions("Implementasi Login & Session<br/><sub>Tabel sessions di Drizzle schema,<br/>verifikasi password via bcrypt,<br/>dan endpoint POST /api/users/login</sub>")

    %% @auth_middleware [ai-task, opened, 2026-10-01, user]
    auth_middleware("Middleware Auth & Guard<br/><sub>Validasi Bearer token dari header,<br/>pencocokan session aktif di DB,<br/>dan proteksi private routes</sub>")

    %% @ultimate_goal [end, opened, 2026-10-01, user]
    ultimate_goal("Sistem Auth Selesai<br/><sub>Sistem registrasi, login, dan<br/>manajemen session berbasis token<br/>siap digunakan untuk endpoint aman</sub>")

    %% === CONNECTIONS ===
    project_start --> setup_stack
    setup_stack --> feature_register
    feature_register --> plan_login_issue
    plan_login_issue --> impl_login_sessions
    impl_login_sessions --> auth_middleware
    auth_middleware -.-> ultimate_goal

    %% === RECENT WORK HIGHLIGHT ===
    subgraph recent [RECENT]
        impl_login_sessions
    end

    %% === STYLES ===
